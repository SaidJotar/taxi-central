generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Taxista {
  id             String        @id @default(uuid())
  nombreCompleto String
  telefono       String        @unique
  passwordHash   String
  estado         EstadoTaxista
  creadoEn       DateTime      @default(now())

  telefonoVerificado         Boolean   @default(false)
  codigoVerificacion         String?
  codigoVerificacionExpiraEn DateTime?
  ultimoEnvioCodigo          DateTime?

  lat                    Float?
  lng                    Float?
  ubicacionActualizadaEn DateTime?

  paradaId      String?
  enParadaDesde DateTime?
  parada        Parada?   @relation("TaxistasEnParada", fields: [paradaId], references: [id])

vehiculo     Vehiculo?
asignaciones AsignacionSolicitud[]
ofertas      OfertaSolicitud[]
reservas     ReservaTaxi[]

  expoPushToken  String?
  sessionVersion Int       @default(1)
  ultimoAccesoEn DateTime?

  objetosPerdidos  ObjetoPerdido[]
  mensajesEnviados MensajeSolicitud[] @relation("MensajesTaxista")
}

model Vehiculo {
  id         String   @id @default(uuid())
  taxistaId  String   @unique
  numeroTaxi String   @unique
  matricula  String?
  marca      String?
  modelo     String?
  creadoEn   DateTime @default(now())

  asignaciones AsignacionSolicitud[]
  taxista      Taxista               @relation(fields: [taxistaId], references: [id], onDelete: Cascade)
}

model SolicitudViaje {
  id                 String           @id @default(uuid())
  nombreCliente      String
  telefonoCliente    String
  direccionRecogida  String
  direccionBase      String?
  referenciaRecogida String?
  estado             EstadoSolicitud
  origen             OrigenSolicitud?
  creadaEn           DateTime         @default(now())
  confirmadaEn       DateTime?

  latRecogida Float?
  lngRecogida Float?

  paradaSugeridaId String?
  paradaSugerida   Parada? @relation("ParadaSugeridaSolicitud", fields: [paradaSugeridaId], references: [id])

  // Inicio / fin de servicio
  recogidaIniciadaEn DateTime?
  completadaEn       DateTime?
  costoFinal         Float?
  duracionMinutos    Int?
  distanciaMetrosEst Int?

  // Valoración del cliente
  ratingCliente    Int?
  comentarioRating String?

  asignacion AsignacionSolicitud?
  ofertas    OfertaSolicitud[]
  mensajes   MensajeSolicitud[]

  @@index([estado])
  @@index([creadaEn])
  @@index([paradaSugeridaId])
}

model OfertaSolicitud {
  id               String       @id @default(uuid())
  solicitudViajeId String
  taxistaId        String
  estado           EstadoOferta @default(pendiente)
  ofrecidaEn       DateTime     @default(now())
  respondidaEn     DateTime?

  solicitudViaje SolicitudViaje @relation(fields: [solicitudViajeId], references: [id], onDelete: Cascade)
  taxista        Taxista        @relation(fields: [taxistaId], references: [id], onDelete: Cascade)

  @@index([solicitudViajeId, estado])
  @@index([taxistaId, estado])
}

model AsignacionSolicitud {
  id               String   @id @default(uuid())
  solicitudViajeId String   @unique
  taxistaId        String
  vehiculoId       String
  asignadaEn       DateTime @default(now())

  solicitudViaje SolicitudViaje @relation(fields: [solicitudViajeId], references: [id], onDelete: Cascade)
  taxista        Taxista        @relation(fields: [taxistaId], references: [id], onDelete: Cascade)
  vehiculo       Vehiculo       @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)

  @@index([taxistaId])
  @@index([vehiculoId])
}

model Parada {
  id        String   @id @default(uuid())
  nombre    String   @unique
  direccion String?
  lat       Float
  lng       Float
  activa    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  taxistas             Taxista[]        @relation("TaxistasEnParada")
  solicitudesSugeridas SolicitudViaje[] @relation("ParadaSugeridaSolicitud")
}

model ObjetoPerdido {
  id            String              @id @default(uuid())
  descripcion   String
  observaciones String?
  estado        EstadoObjetoPerdido @default(con_taxista)

  fechaHallazgo DateTime @default(now())
  creadoEn      DateTime @default(now())

  entregadoCentralEn DateTime?
  entregadoClienteEn DateTime?

  taxistaId String
  taxista   Taxista @relation(fields: [taxistaId], references: [id], onDelete: Restrict)

  @@index([taxistaId, estado])
  @@index([estado, creadoEn])
}

model MensajeSolicitud {
  id               String            @id @default(uuid())
  solicitudViajeId String
  emisorTipo       TipoEmisorMensaje
  emisorTaxistaId  String?
  texto            String
  leido            Boolean           @default(false)
  creadoEn         DateTime          @default(now())

  solicitudViaje SolicitudViaje @relation(fields: [solicitudViajeId], references: [id], onDelete: Cascade)
  emisorTaxista  Taxista?       @relation("MensajesTaxista", fields: [emisorTaxistaId], references: [id], onDelete: SetNull)

  @@index([solicitudViajeId, creadoEn])
  @@index([emisorTaxistaId])
}

model ReservaTaxi {
  id String @id @default(uuid())

  tipo         TipoReserva @default(normal)
  tipoEspecial TipoReservaEspecial?

  telefonoCliente String

  latRecogida Float?
  lngRecogida Float?

  direccionRecogida  String
  direccionBase      String?
  referenciaRecogida String?

  fechaHora DateTime

  // Reserva normal:
  // 05:00 - 20:59 = 10 €
  // 21:00 - 04:59 = 15 €
  precioFinal Float?

  // Para Tánger, Tetuán, bodas, etc.
  precioAConvenir Boolean @default(false)

  detallesEspeciales String?

  estado EstadoReserva @default(pendiente)

  taxistaId String?
  taxista   Taxista? @relation(fields: [taxistaId], references: [id], onDelete: SetNull)

  creadaEn     DateTime  @default(now())
  aceptadaEn   DateTime?
  canceladaEn  DateTime?
  completadaEn DateTime?

  @@index([estado, fechaHora])
  @@index([taxistaId, estado])
  @@index([telefonoCliente, fechaHora])
}

enum TipoReserva {
  normal
  especial
}

enum EstadoReserva {
  pendiente
  aceptada
  cancelada
  en_servicio
  completada
}

enum TipoReservaEspecial {
  aeropuerto_tanger
  aeropuerto_tetuan
  boda_evento
  otro
}

enum EstadoObjetoPerdido {
  con_taxista
  en_central
  entregado_cliente
}

enum EstadoTaxista {
  desconectado
  disponible
  ocupado
}

enum EstadoSolicitud {
  pendiente
  ofertada
  asignada
  sin_taxista
  cancelada
  completada
}

enum EstadoOferta {
  pendiente
  aceptada
  rechazada
  expirada
}

enum OrigenSolicitud {
  llamada_ia
  operador
  web
  app_cliente
}

enum TipoEmisorMensaje {
  cliente
  taxista
}
