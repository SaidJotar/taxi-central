{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://dev-api.sjaceuta.es",
        "EXPO_PUBLIC_SOCKET_URL": "https://dev-api.sjaceuta.es"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.sjaceuta.es",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.sjaceuta.es"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.sjaceuta.es",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.sjaceuta.es"
      }
    }
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
